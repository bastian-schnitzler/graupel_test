{
  "name": "Graupel",
  "short_name": "Graupel",
  "description": "Weather forecasts as meteograms. Weather data you fetch stays in the history: view it offline or compare it with newer data. A better view on phone and tablet, without the browser’s bars.",
  "lang": "en",
  "id": "./",
  "start_url": "./",
  "scope": "./",
  "display": "fullscreen",
  "display_override": [
    "fullscreen",
    "standalone"
  ],
  "theme_color": "#f4f6f8",
  "background_color": "#f4f6f8",
  "user_preferences": {
    "color_scheme": {
      "dark": {
        "theme_color": "#11161c",
        "background_color": "#11161c"
      }
    }
  },
  "icons": [
    {
      "src": "../app-icons/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "../app-icons/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "../app-icons/icon-192-maskable.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "maskable"
    },
    {
      "src": "../app-icons/icon-512-maskable.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "screenshots": [
    {
      "src": "../app-screenshots/wide-en.png",
      "sizes": "1280x800",
      "type": "image/png",
      "form_factor": "wide",
      "label": "Meteogram with the forecast of several weather models"
    },
    {
      "src": "../app-screenshots/narrow-en.png",
      "sizes": "780x1688",
      "type": "image/png",
      "form_factor": "narrow",
      "label": "Meteogram on the phone"
    }
  ]
}
