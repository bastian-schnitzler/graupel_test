{
  "name": "Graupel",
  "short_name": "Graupel",
  "description": "Wettervorhersagen als Meteogramme. Abgerufene Wetterdaten bleiben in der Historie: Du kannst sie offline ansehen oder mit neueren Daten vergleichen. Bessere Darstellung auf Telefon und Tablet, ohne die Leisten des Browsers.",
  "lang": "de",
  "id": "./",
  "start_url": "./",
  "scope": "./",
  "display": "fullscreen",
  "display_override": [
    "fullscreen",
    "standalone"
  ],
  "theme_color": "#f4f6f8",
  "background_color": "#f4f6f8",
  "user_preferences": {
    "color_scheme": {
      "dark": {
        "theme_color": "#11161c",
        "background_color": "#11161c"
      }
    }
  },
  "icons": [
    {
      "src": "../app-icons/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "../app-icons/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "../app-icons/icon-192-maskable.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "maskable"
    },
    {
      "src": "../app-icons/icon-512-maskable.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "screenshots": [
    {
      "src": "../app-screenshots/wide-de.png",
      "sizes": "1280x800",
      "type": "image/png",
      "form_factor": "wide",
      "label": "Meteogramm mit der Vorhersage mehrerer Wettermodelle"
    },
    {
      "src": "../app-screenshots/narrow-de.png",
      "sizes": "780x1688",
      "type": "image/png",
      "form_factor": "narrow",
      "label": "Meteogramm auf dem Telefon"
    }
  ]
}
