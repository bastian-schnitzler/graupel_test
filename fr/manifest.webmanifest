{
  "name": "Graupel",
  "short_name": "Graupel",
  "description": "Prévisions météo sous forme de météogrammes. Les données météo récupérées restent dans l’historique : vous pouvez les consulter hors ligne ou les comparer à des données plus récentes. Un meilleur affichage sur téléphone et tablette, sans les barres du navigateur.",
  "lang": "fr",
  "id": "./",
  "start_url": "./",
  "scope": "./",
  "display": "fullscreen",
  "display_override": [
    "fullscreen",
    "standalone"
  ],
  "theme_color": "#f4f6f8",
  "background_color": "#f4f6f8",
  "user_preferences": {
    "color_scheme": {
      "dark": {
        "theme_color": "#11161c",
        "background_color": "#11161c"
      }
    }
  },
  "icons": [
    {
      "src": "../app-icons/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "../app-icons/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "../app-icons/icon-192-maskable.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "maskable"
    },
    {
      "src": "../app-icons/icon-512-maskable.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "screenshots": [
    {
      "src": "../app-screenshots/wide-fr.png",
      "sizes": "1280x800",
      "type": "image/png",
      "form_factor": "wide",
      "label": "Météogramme avec les prévisions de plusieurs modèles météo"
    },
    {
      "src": "../app-screenshots/narrow-fr.png",
      "sizes": "780x1688",
      "type": "image/png",
      "form_factor": "narrow",
      "label": "Météogramme sur le téléphone"
    }
  ]
}
