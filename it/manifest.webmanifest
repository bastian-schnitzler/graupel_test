{
  "name": "Graupel",
  "short_name": "Graupel",
  "description": "Previsioni del tempo come meteogrammi. I dati meteorologici scaricati restano nella cronologia: puoi vederli offline o confrontarli con dati più recenti. Una visualizzazione migliore su telefono e tablet, senza le barre del browser.",
  "lang": "it",
  "id": "./",
  "start_url": "./",
  "scope": "./",
  "display": "fullscreen",
  "display_override": [
    "fullscreen",
    "standalone"
  ],
  "theme_color": "#f4f6f8",
  "background_color": "#f4f6f8",
  "user_preferences": {
    "color_scheme": {
      "dark": {
        "theme_color": "#11161c",
        "background_color": "#11161c"
      }
    }
  },
  "icons": [
    {
      "src": "../app-icons/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "../app-icons/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "../app-icons/icon-192-maskable.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "maskable"
    },
    {
      "src": "../app-icons/icon-512-maskable.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "screenshots": [
    {
      "src": "../app-screenshots/wide-it.png",
      "sizes": "1280x800",
      "type": "image/png",
      "form_factor": "wide",
      "label": "Meteogramma con le previsioni di più modelli meteorologici"
    },
    {
      "src": "../app-screenshots/narrow-it.png",
      "sizes": "780x1688",
      "type": "image/png",
      "form_factor": "narrow",
      "label": "Meteogramma sul telefono"
    }
  ]
}
